{
  "name": "@pjan/grafana-styling",
  "version": "0.0.0",
  "private": true,
  "description": "Opt-in styling helpers shared by pjan's Grafana panel plugins, bundled into each plugin from source",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different ."
  },
  "peerDependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "13.2.3",
    "@grafana/i18n": "13.2.3",
    "@grafana/ui": "13.2.3",
    "react": "^19.0.0",
    "tinycolor2": "1.6.0"
  },
  "devDependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "13.2.3",
    "@grafana/eslint-config": "^9.0.0",
    "@grafana/i18n": "13.2.3",
    "@grafana/tsconfig": "^2.2.0",
    "@grafana/ui": "13.2.3",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.0.0",
    "@types/tinycolor2": "1.4.6",
    "eslint": "^9.32.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tinycolor2": "1.6.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
